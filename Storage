function GetPriceWithCondition(basePrice, condition)
    condition = math.clamp(condition, 0, 100) / 100

    local floor = math.clamp(basePrice / 1000, 0, 1) * 0.35 + 0.25
    local multiplier = floor + (1 - floor) * condition

    local price = basePrice * multiplier

    return math.floor(price * 100 + 0.5) / 100
end

